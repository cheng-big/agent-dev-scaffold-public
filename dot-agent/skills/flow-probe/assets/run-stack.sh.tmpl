#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
# run-stack —— 起隔离栈跑「浏览器真流程测试」（flow-probe skill 模板）
#   用法：bash harness/run-stack.sh <CODE>        # 单系统，如 ORDER / USER / ...
#         bash harness/run-stack.sh all           # 依序跑全部系统
#   环境：HEADLESS=true(默认，稳定出报告) / HEADLESS=false(有头肉眼看点页面)
#
#   流程：建隔离库 → 迁移 → 起后端 → 起前端 → Playwright 跑探针 → 合并报告 → trap 拆栈清库
#   探针文件约定：harness/<code 小写>-flow-probe.mjs
#
#   >>> 把本文件改名 run-stack.sh，然后只改下方【CONFIG】一段成你项目的。 <<<
# ════════════════════════════════════════════════════════════════════
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# ══════════════════════ 【CONFIG】按你的项目改这一段 ══════════════════════
DB="myapp_flow_check"                                   # 隔离测试库名（独立于正式库，跑完 DROP）
BACKEND_PORT=8087; WEB_PORT=5181; PORTAL_PORT=5182; H5_PORT=5183
BACKEND_READY='Started .*Application'                   # 后端就绪日志标记（grep 用；如 Spring 的 "Started XxxApplication"）
ALL_CODES=(SYS_A SYS_B)                                 # 你项目的系统清单（对齐 flow-probe.config.mjs 的 systems）
HAS_PORTAL=true                                         # 有独立公众/政务门户前端吗？无则改 false

# 建/删隔离库（按你的 DB 改；这里示例 MySQL root/123）
db_create() { mysql -uroot -p123 -e "DROP DATABASE IF EXISTS ${DB}; CREATE DATABASE ${DB} DEFAULT CHARACTER SET utf8mb4;" ; }
db_drop()   { mysql -uroot -p123 -e "DROP DATABASE IF EXISTS ${DB};" >/dev/null 2>&1 ; }

# 编译 + 启动后端（连隔离库、监听 BACKEND_PORT；迁移工具随启动自动跑，如 Flyway）
backend_compile() { (cd "$ROOT" && mvn -q -DskipTests compile) ; }
backend_start()   {
  (cd "$ROOT" && mvn -q spring-boot:run -Dspring-boot.run.jvmArguments="\
    -Dserver.port=${BACKEND_PORT} \
    -Dspring.datasource.url=jdbc:mysql://localhost:3306/${DB}?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true \
    -Dspring.datasource.username=root -Dspring.datasource.password=123")
}
# 启动前端（各端；没有的端把函数体留空即可）
web_start()    { (cd "$ROOT/apps/web"    && VITE_API_TARGET="http://127.0.0.1:${BACKEND_PORT}"       npm run dev -- --host 127.0.0.1 --port "$WEB_PORT"    --strictPort) ; }
portal_start() { (cd "$ROOT/apps/portal" && VITE_API_PROXY_TARGET="http://127.0.0.1:${BACKEND_PORT}" npm run dev -- --host 127.0.0.1 --port "$PORTAL_PORT" --strictPort) ; }
h5_start()     { (cd "$ROOT/apps/h5"     && VITE_API_PROXY_TARGET="http://127.0.0.1:${BACKEND_PORT}" npm run dev -- --host 127.0.0.1 --port "$H5_PORT"     --strictPort) ; }
# ════════════════════════ 【CONFIG 结束，下面一般不用改】 ════════════════════════

BACKEND_LOG=/tmp/fp_backend.log; WEB_LOG=/tmp/fp_web.log; PORTAL_LOG=/tmp/fp_portal.log; H5_LOG=/tmp/fp_h5.log
BACKEND_PID=""; WEB_PID=""; PORTAL_PID=""; H5_PID=""

usage() { echo "用法: bash harness/run-stack.sh <CODE|all>  (CODE: ${ALL_CODES[*]})"; exit 1; }
[ $# -ge 1 ] || usage
ARG="$1"
TARGETS=(); if [ "$ARG" = "all" ]; then TARGETS=("${ALL_CODES[@]}"); else TARGETS=("$ARG"); fi
NEED_H5="false"; for c in "${TARGETS[@]}"; do [ "$c" = "MOBILE" ] && NEED_H5="true"; done

cleanup() {
  set +e
  for pid in "$H5_PID" "$PORTAL_PID" "$WEB_PID" "$BACKEND_PID"; do [ -n "$pid" ] && kill "$pid" 2>/dev/null; done
  for p in "$H5_PORT" "$PORTAL_PORT" "$WEB_PORT" "$BACKEND_PORT"; do lsof -ti ":${p}" 2>/dev/null | xargs kill 2>/dev/null; done
  db_drop
}
trap cleanup EXIT INT TERM

for p in "$BACKEND_PORT" "$WEB_PORT" "$PORTAL_PORT" "$H5_PORT"; do lsof -ti ":${p}" 2>/dev/null | xargs kill 2>/dev/null || true; done
echo "[flow-probe] 建隔离库 ${DB}"; db_create || { echo "建库失败"; exit 1; }

echo "[flow-probe] 编译后端"; backend_compile || { echo "编译失败"; exit 1; }
echo "[flow-probe] 启动后端 ${BACKEND_PORT}（迁移自动跑）"
backend_start >"$BACKEND_LOG" 2>&1 & BACKEND_PID=$!
for _ in $(seq 1 120); do
  grep -qE "$BACKEND_READY" "$BACKEND_LOG" 2>/dev/null && break
  grep -qE "APPLICATION FAILED TO START|BUILD FAILURE|migrat.*failed|Flyway.*failed" "$BACKEND_LOG" 2>/dev/null && { tail -80 "$BACKEND_LOG"; exit 1; }
  sleep 1
done
grep -qE "$BACKEND_READY" "$BACKEND_LOG" || { echo "后端启动超时"; tail -80 "$BACKEND_LOG"; exit 1; }

echo "[flow-probe] 启动 Web ${WEB_PORT}"; web_start >"$WEB_LOG" 2>&1 & WEB_PID=$!
for _ in $(seq 1 40); do curl -fsS "http://127.0.0.1:${WEB_PORT}/" >/dev/null 2>&1 && break; sleep 1; done

# 门户/移动端可选
if [ "$HAS_PORTAL" = "true" ]; then
  echo "[flow-probe] 启动 Portal ${PORTAL_PORT}"; portal_start >"$PORTAL_LOG" 2>&1 & PORTAL_PID=$!
  for _ in $(seq 1 40); do curl -fsS "http://127.0.0.1:${PORTAL_PORT}/" >/dev/null 2>&1 && break; sleep 1; done
fi
if [ "$NEED_H5" = "true" ]; then
  echo "[flow-probe] 启动 H5 ${H5_PORT}"; h5_start >"$H5_LOG" 2>&1 & H5_PID=$!
  for _ in $(seq 1 40); do curl -fsS "http://127.0.0.1:${H5_PORT}/" >/dev/null 2>&1 && break; sleep 1; done
fi

export BASE_URL="http://127.0.0.1:${BACKEND_PORT}"
export WEB_URL="http://127.0.0.1:${WEB_PORT}"
export PORTAL_URL="http://127.0.0.1:${PORTAL_PORT}"
export H5_URL="http://127.0.0.1:${H5_PORT}"

for code in "${TARGETS[@]}"; do
  lc="$(echo "$code" | tr '[:upper:]' '[:lower:]')"
  probe="$ROOT/harness/${lc}-flow-probe.mjs"
  [ -f "$probe" ] || { echo "[flow-probe] ⚠ 跳过 ${code}：探针文件不存在 ${probe}"; continue; }
  echo "[flow-probe] 跑 ${code} 深探针（HEADLESS=${HEADLESS:-true}）"
  HEADLESS="${HEADLESS:-true}" node "$probe" || echo "[flow-probe] ⚠ ${code} 探针非零退出（结果已尽量落盘，继续）"
done

echo "[flow-probe] 合并渲染报告"; node "$ROOT/harness/build-report.mjs"
echo "FLOW_PROBE_STACK_DONE"
